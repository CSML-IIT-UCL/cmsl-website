{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CSML: Start live preview",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": false }
    },
    {
      "label": "CSML: Update one person's publications",
      "type": "process",
      "command": "node",
      "args": ["scripts/update-publications.mjs", "--person", "${input:personId}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
    }
  ],
  "inputs": [
    {
      "id": "personId",
      "type": "promptString",
      "description": "Stable person ID from npm run publications:list"
    }
  ]
}
