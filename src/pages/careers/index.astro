---
import { getCollection, render } from 'astro:content';
import EmptyState from '@/components/EmptyState.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const now = new Date();
const openings = (await getCollection('openings', ({ data }) => !data.draft && data.status === 'open' && (!data.deadline_at || data.deadline_at > now)))
  .sort((a, b) => a.data.published_at.getTime() - b.data.published_at.getTime());
const renderedOpenings = await Promise.all(openings.map(async (opening) => ({
  opening,
  Content: (await render(opening)).Content,
})));
---

<BaseLayout title="Career Opportunities" description="Open positions and application guidance for CSML at IIT.">
  <div class="page-shell shell">
    <SectionHeading eyebrow="Careers" title="Work with CSML" intro="Each opening below links to its official application page and deadline." />
    {openings.length > 0 ? (
      <div class="opening-list">
        {renderedOpenings.map(({ opening, Content }) => {
          return (
            <article class="opening-card">
              <span class="status">{opening.data.application_type.replace('_', ' ')}</span>
              <h2>{opening.data.title}</h2>
              <div class="prose compact"><Content /></div>
              {opening.data.deadline_at && <p>Deadline: <time datetime={opening.data.deadline_at.toISOString()}>{opening.data.deadline_at.toLocaleDateString('en-GB')}</time></p>}
              {opening.data.apply_url && <a class="button" href={opening.data.apply_url}>Official application</a>}
            </article>
          );
        })}
      </div>
    ) : <EmptyState title="No verified openings currently published" message="Check back soon, or see the PhD guidance below." />}
    <section class="application-note">
      <h2>PhD applications</h2>
      <p>CSML does not currently have an open, position-specific PhD call. PhD recruitment at IIT runs through annual, university-affiliated calls by research domain; browse <a href="https://www.iit.it/en/phd">IIT's Open PhD Positions</a> for the current round, or get in touch with the group once a relevant call opens.</p>
      <p>CV submission for general expressions of interest isn't available on this site yet.</p>
    </section>
    <section class="application-note">
      <h2>Postdoctoral and other applications</h2>
      <p>The postdoctoral openings above link to IIT's official application portal, where you submit your materials directly. A CV-submission option for general expressions of interest isn't available yet.</p>
    </section>
  </div>
</BaseLayout>
