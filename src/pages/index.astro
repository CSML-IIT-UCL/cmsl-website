---
import { getCollection, getEntry, render } from 'astro:content';
import EmptyState from '@/components/EmptyState.astro';
import NewsItem from '@/components/NewsItem.astro';
import PersonCard from '@/components/PersonCard.astro';
import PersonProfile from '@/components/PersonProfile.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mediaUrl } from '@/lib/paths';
import { getSiteConfig } from '@/lib/site';
import { getSocialConfig } from '@/lib/social';

const site = getSiteConfig();
const social = getSocialConfig();
const socialClientConfig = {
  bluesky: {
    enabled: social.bluesky.enabled,
    actor: social.bluesky.actor,
    maxItems: social.bluesky.max_items,
    cacheSeconds: social.bluesky.session_cache_seconds,
  },
};
const allPeople = (await getCollection('people', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const currentPeople = allPeople.filter((person) => person.data.status !== 'alumni');
const alumni = allPeople.filter((person) => person.data.status === 'alumni');
const pi = allPeople.find((person) => person.data.id === site.principal_investigator_id);
if (!pi) throw new Error(`Configured PI '${site.principal_investigator_id}' is not a published person.`);
const research = (await getCollection('research', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news', ({ data }) => !data.draft && data.published_at <= new Date())).sort((a, b) => b.data.published_at.getTime() - a.data.published_at.getTime());
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const projectPages = Array.from({ length: Math.ceil(projects.length / 4) }, (_, i) => projects.slice(i * 4, i * 4 + 4));
const hero = mediaUrl(site.hero.image);
const about = await getEntry('about', 'about');
if (!about) throw new Error('content/about.md is missing.');
const { Content: AboutContent } = await render(about);
---

<BaseLayout>
  <section class:list={['hero', !hero && 'hero-placeholder']} aria-labelledby="hero-title">
    {hero && <img src={hero} alt={site.hero.alt ?? 'CSML team'} style={`object-position:${site.hero.focal_position}`} fetchpriority="high" />}
    <div class="shell hero-copy">
      <h1 id="hero-title">Computational Statistics &amp; Machine Learning</h1>
      <p>Foundational methods for reliable learning, scientific discovery and dynamical systems.</p>
    </div>
  </section>

  <section id="about" class="section shell about-stack">
    <div>
      <SectionHeading title="About the group" />
      <div class="prose large"><AboutContent /></div>
    </div>
    <aside class="pi-card" aria-label="Principal investigator">
      <p class="eyebrow">Principal investigator</p>
      <PersonProfile person={pi} showPublications={false} showTags={false} showRelationship={false} />
    </aside>
  </section>

  <section id="research" class="section section-tint">
    <div class="shell">
      <SectionHeading title="Research" />
      <div class="research-grid">
        {research.map((item, index) => <ResearchCard item={item} index={index} />)}
      </div>
    </div>
  </section>

  <section id="updates" class="section shell">
    <SectionHeading title="Updates" />
    <div class="updates-stack">
      <div class="updates-panel">
        <div class="panel-heading"><h3>Group news</h3><span>{news.length}</span></div>
        <div class="updates-scroll" data-news-list>
          {news.length > 0 ? news.map((item) => <NewsItem item={item} />) : <EmptyState title="No published news yet" message="Verified announcements will appear here as content entries are approved." />}
        </div>
      </div>
      <div class="updates-panel social-card social-feed" data-platform="bluesky" data-state={social.bluesky.enabled ? 'loading' : 'unavailable'}>
        <div class="panel-heading">
          <h3>Bluesky</h3>
          <span class="social-fetched-at"></span>
        </div>
        <ul class="social-list" aria-live="polite"></ul>
        <div class="social-placeholder">
          <p class="social-status-loading">Loading recent Bluesky posts…</p>
          <p class="social-status-empty">No recent posts to show.</p>
          <p class="social-status-error">Bluesky posts could not be loaded right now.</p>
          <p class="social-status-unavailable">Live Bluesky cards are not enabled.</p>
          <button type="button" class="button secondary social-retry">Try again</button>
          <a class="button secondary" href="https://bsky.app/profile/pontilgroup.bsky.social">Open Bluesky profile</a>
        </div>
      </div>
    </div>
  </section>

  <template id="social-post-template">
    <li class="social-post">
      <img class="social-post-avatar" alt="" aria-hidden="true" loading="lazy" />
      <div class="social-post-body">
        <p class="social-post-byline"><span class="social-post-author"></span> <span class="social-post-handle"></span></p>
        <p class="social-post-text"></p>
        <a class="social-post-link text-link" target="_blank" rel="noopener noreferrer">
          <time class="social-post-time"></time>
        </a>
      </div>
    </li>
  </template>

  <script type="application/json" id="social-config" set:html={JSON.stringify(socialClientConfig)} />
  <script>
    import '@/scripts/social-feed';
  </script>
  <script>
    import '@/scripts/news-panel';
  </script>

  <section id="people" class="section shell">
    <SectionHeading title="People" />
    {site.role_groups.map((group) => {
      const members = currentPeople.filter((person) => person.data.role === group.key);
      if (members.length === 0) return null;
      return (
        <section class="people-group" aria-labelledby={`group-${group.key}`}>
          <h3 id={`group-${group.key}`}>{group.label}</h3>
          <div class="people-grid">{members.map((person) => <PersonCard person={person} />)}</div>
        </section>
      );
    })}
    {alumni.length > 0 && (
      <section class="people-group" aria-labelledby="group-alumni">
        <h3 id="group-alumni">Alumni</h3>
        <div class="people-grid">{alumni.map((person) => <PersonCard person={person} />)}</div>
      </section>
    )}
  </section>

  <section id="projects" class="section section-tint">
    <div class="shell">
      <SectionHeading title="Projects" />
      {projects.length > 0 ? (
        <div class="project-pager" data-project-pager>
          <div class="project-scroll" data-project-scroll tabindex="0" role="group" aria-label="Funded projects, most recent first" aria-roledescription="carousel">
            {projectPages.map((page) => (
              <div class="project-page">
                {page.map((project) => <ProjectCard project={project} />)}
              </div>
            ))}
          </div>
          {projectPages.length > 1 && (
            <div class="project-pager-controls">
              <button type="button" class="pager-btn" data-project-prev aria-label="Show previous projects">
                <span aria-hidden="true">←</span>
              </button>
              <div class="pager-dots" data-project-dots role="tablist" aria-label="Project pages">
                {projectPages.map((_, index) => (
                  <button type="button" class="pager-dot" data-project-dot data-index={index} role="tab" aria-label={`Projects page ${index + 1}`}></button>
                ))}
              </div>
              <button type="button" class="pager-btn" data-project-next aria-label="Show next projects">
                <span aria-hidden="true">→</span>
              </button>
            </div>
          )}
        </div>
      ) : <EmptyState title="Projects coming soon" message="Check back soon." />}
    </div>
  </section>

  <script>
    import '@/scripts/project-pager';
  </script>
</BaseLayout>
