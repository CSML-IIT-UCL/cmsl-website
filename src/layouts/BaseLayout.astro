---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { getSiteConfig } from '@/lib/site';
import { mediaUrl } from '@/lib/paths';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'profile' | 'article';
  ogImage?: string | null;
  structuredData?: Record<string, unknown> | Record<string, unknown>[] | null;
}
const site = getSiteConfig();
const { title, description = site.description, ogType = 'website', ogImage, structuredData } = Astro.props;
const pageTitle = title ? `${title} · ${site.short_title}` : `${site.short_title} · IIT`;
const siteEnvironment = import.meta.env.PUBLIC_SITE_ENV ?? 'production';
const isPreview = siteEnvironment === 'staging';
const commit = import.meta.env.PUBLIC_COMMIT_SHA ?? 'local';
const buildTime = import.meta.env.PUBLIC_BUILD_TIME ?? 'local build';
const icon = mediaUrl('/media/csml_logos/IIT-logo-CSML T1 POS.png')!;
const iconAbsoluteUrl = new URL(icon, Astro.site).toString();
const imageAbsoluteUrl = ogImage ? new URL(ogImage, Astro.site).toString() : iconAbsoluteUrl;
const pageAbsoluteUrl = new URL(Astro.url.pathname, Astro.site).toString();
// Escape '</' so embedded content (e.g. a bio containing the literal text "</script>")
// can never close the JSON-LD script element early.
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/<\//g, '<\\/')
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {isPreview && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#f3f6f8" />
    <title>{pageTitle}</title>

    <link rel="icon" href={icon} type="image/png" />
    <link rel="apple-touch-icon" href={icon} />
    <link rel="canonical" href={pageAbsoluteUrl} />

    <meta property="og:site_name" content={site.short_title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageAbsoluteUrl} />
    <meta property="og:image" content={imageAbsoluteUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbsoluteUrl} />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    {isPreview && (
      <div class="preview-banner" role="status">
        Development preview · revision {commit.slice(0, 8)} · {buildTime}
      </div>
    )}
    <SiteHeader site={site} />
    <main id="main-content"><slot /></main>
    <SiteFooter site={site} />
  </body>
</html>
