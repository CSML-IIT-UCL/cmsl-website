---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { getSiteConfig } from '@/lib/site';
import '@/styles/global.css';

interface Props { title?: string; description?: string }
const site = getSiteConfig();
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.short_title}` : `${site.short_title} · IIT`;
const siteEnvironment = import.meta.env.PUBLIC_SITE_ENV ?? 'production';
const isPreview = siteEnvironment === 'staging';
const commit = import.meta.env.PUBLIC_COMMIT_SHA ?? 'local';
const buildTime = import.meta.env.PUBLIC_BUILD_TIME ?? 'local build';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {isPreview && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#f4f7f6" />
    <title>{pageTitle}</title>
  </head>
  <body>
    {isPreview && (
      <div class="preview-banner" role="status">
        Development preview · revision {commit.slice(0, 8)} · {buildTime}
      </div>
    )}
    <SiteHeader site={site} />
    <main id="main-content"><slot /></main>
    <SiteFooter site={site} />
  </body>
</html>
