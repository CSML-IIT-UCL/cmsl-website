---
import { render, type CollectionEntry } from 'astro:content';
import { mediaUrl } from '@/lib/paths';
import { countryName, flagIconPath } from '@/lib/nationality';
import { coverageForPerson, publicationsForPerson } from '@/lib/publications';
import { readableEmailFallback, splitEmail } from '@/lib/obfuscate';
import PublicationList from '@/components/PublicationList.astro';
import SocialIcon from '@/components/SocialIcon.astro';

interface Props { person: CollectionEntry<'people'>; showPublications?: boolean; showTags?: boolean; showRelationship?: boolean }
const { person, showPublications = true, showTags = true, showRelationship = true } = Astro.props;
const iconPlatformFor = (label: string): 'github' | 'linkedin' | 'scholar' | 'x' | null => {
  const key = label.toLowerCase();
  if (key === 'github') return 'github';
  if (key === 'linkedin') return 'linkedin';
  if (key === 'scholar' || key === 'google scholar') return 'scholar';
  if (key === 'x' || key === 'twitter') return 'x';
  return null;
};
const { Content } = await render(person);
const photo = mediaUrl(person.data.photo);
const initials = person.data.name.split(/\s+/).slice(0, 2).map((word) => word[0]).join('');
const nationality = person.data.nationality;
const nationalityName = nationality ? countryName(nationality) ?? nationality : null;
const flagSrc = nationality ? mediaUrl(flagIconPath(nationality)) : null;
const website = person.data.personal_website ?? person.data.iit_profile;
const publications = publicationsForPerson(person.data.id);
const coverage = coverageForPerson(person.data.id);
const relationship = person.data.status === 'alumni'
  ? 'Former colleague'
  : person.data.status === 'affiliated'
    ? 'Affiliated researcher'
    : 'CSML member';
// Split rather than a plain mailto: href so the address never appears as a literal
// string in the static HTML scrapers crawl; the inline script below upgrades this
// to a real mailto link once JS runs, and the fallback text stays human-readable.
const email = person.data.email;
const emailParts = email ? splitEmail(email) : null;
const emailFallback = email ? readableEmailFallback(email) : null;
---

<article class="profile">
  <div class="profile-header">
    <div class="profile-portrait">
      {photo
        ? <img src={photo} alt={person.data.photo_alt ?? `Portrait of ${person.data.name}`} />
        : <span aria-hidden="true">{initials}</span>}
      {flagSrc && (
        <img class="nationality-flag" src={flagSrc} alt={`${nationalityName} flag`} title={nationalityName} />
      )}
    </div>
    <div>
      {showRelationship && <p class="eyebrow">{relationship}</p>}
      <h1>{person.data.name}</h1>
      <p class="profile-role">{person.data.role_label}</p>
      {person.data.status === 'alumni' && (
        <p class="profile-current-affiliation">
          {person.data.current_affiliation ?? 'Current affiliation not yet verified'}
        </p>
      )}
      <div class="profile-links" aria-label={`${person.data.name} links`}>
        {website && <a class="button secondary" href={website}>Website</a>}
        {emailParts && (
          <span class="email-link" data-email-user={emailParts.user} data-email-domain={emailParts.domain}>
            {emailFallback}
          </span>
        )}
        {person.data.orcid && <SocialIcon platform="orcid" href={`https://orcid.org/${person.data.orcid}`} />}
        {person.data.scholar_url && <SocialIcon platform="scholar" href={person.data.scholar_url} />}
        {person.data.github_url && <SocialIcon platform="github" href={person.data.github_url} />}
        {person.data.linkedin_url && <SocialIcon platform="linkedin" href={person.data.linkedin_url} />}
        {person.data.x_url && <SocialIcon platform="x" href={person.data.x_url} />}
        {person.data.bluesky_url && <SocialIcon platform="bluesky" href={person.data.bluesky_url} />}
        {person.data.openalex_ids.map((authorId, index) => (
          <a class="button secondary" href={`https://openalex.org/${authorId}`}>
            OpenAlex{person.data.openalex_ids.length > 1 ? ` ${index + 1}` : ''}
          </a>
        ))}
        {person.data.media_links.map((item) => {
          const platform = iconPlatformFor(item.label);
          return platform
            ? <SocialIcon platform={platform} href={item.url} label={item.label} />
            : <a class="button secondary" href={item.url}>{item.label}</a>;
        })}
      </div>
    </div>
  </div>
  {person.body && <div class="prose profile-biography"><Content /></div>}
  {showTags && person.data.research_interests.length > 0 && (
    <ul class="tag-list" aria-label="Research interests">
      {person.data.research_interests.map((interest) => <li>{interest}</li>)}
    </ul>
  )}
  {showPublications && (
    <section class="profile-publications" aria-labelledby="profile-publications-title">
      <h2 id="profile-publications-title">Publications</h2>
      {publications.length > 0 ? (
        <PublicationList publications={publications} />
      ) : (
        <p class="muted">
          {coverage
            ? 'No publications are present in the current OpenAlex cache.'
            : person.data.openalex_ids.length > 0
              ? 'This verified OpenAlex profile has not yet been refreshed into the site cache.'
              : 'Publication identity has not yet been linked to a verified OpenAlex author record.'}
        </p>
      )}
    </section>
  )}
</article>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('.email-link[data-email-user]')) {
    const user = el.dataset.emailUser;
    const domain = el.dataset.emailDomain;
    if (!user || !domain) continue;
    const link = document.createElement('a');
    link.className = 'button secondary';
    link.href = `mailto:${user}@${domain}`;
    link.textContent = 'Email';
    el.replaceWith(link);
  }
</script>
