---
import type { CollectionEntry } from 'astro:content';
import { mediaUrl, withBase } from '@/lib/paths';
import { countryName, flagIconPath } from '@/lib/nationality';

interface Props { person: CollectionEntry<'people'> }
const { person } = Astro.props;
const photo = mediaUrl(person.data.photo);
const initials = person.data.name.split(/\s+/).slice(0, 2).map((word) => word[0]).join('');
const nationality = person.data.nationality;
const nationalityName = nationality ? countryName(nationality) ?? nationality : null;
const flagSrc = nationality ? mediaUrl(flagIconPath(nationality)) : null;
---

<article class="person-card">
  <a href={withBase(`people/${person.data.id}/`)} aria-label={`View ${person.data.name}'s profile`}>
    <div class="person-portrait">
      {photo
        ? <img src={photo} alt={person.data.photo_alt ?? `Portrait of ${person.data.name}`} loading="lazy" />
        : <span aria-hidden="true">{initials}</span>}
    </div>
    <div class="person-card-copy">
      <h4>{person.data.name}</h4>
      {person.data.status === 'alumni' ? (
        <>
          <p class="current-affiliation">{person.data.current_affiliation ?? 'Current affiliation not yet verified'}</p>
          <p class="role-label past-role">{person.data.role_label}</p>
        </>
      ) : (
        <p class="role-label">{person.data.role_label}</p>
      )}
    </div>
    {flagSrc && (
      <img class="nationality-flag" src={flagSrc} alt={`${nationalityName} flag`} title={nationalityName} loading="lazy" />
    )}
  </a>
</article>
