---
import { render, type CollectionEntry } from 'astro:content';
import { mediaUrl } from '@/lib/paths';

interface Props { item: CollectionEntry<'research'>; index: number }
const { item, index } = Astro.props;
const { Content } = await render(item);
const media = mediaUrl(item.data.media.src);
---

<article class="research-card">
  <div class="research-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  {media && (
    <div class="research-media">
      <img src={media} alt={item.data.media.alt ?? ''} loading="lazy" style={`object-fit:${item.data.media.fit};object-position:${item.data.media.position}`} />
    </div>
  )}
  <div>
    <h3>{item.data.title}</h3>
    <div class="prose compact"><Content /></div>
    {item.data.link && <a class="text-link" href={item.data.link}>Explore this research <span aria-hidden="true">↗</span></a>}
  </div>
</article>
