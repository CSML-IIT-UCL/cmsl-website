---
import type { CollectionEntry } from 'astro:content';
import { mediaUrl } from '@/lib/paths';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const logo = mediaUrl(project.data.project_logo);
const funders = project.data.funders.map((funder) => ({ ...funder, logo: mediaUrl(funder.logo) }));
const startYear = project.data.start_date?.getUTCFullYear();
const endYear = project.data.end_date?.getUTCFullYear();
---

<article class="project-card">
  <div class="project-card-top">
    <div class:list={['project-logo', logo && 'project-logo-large']}>
      {logo
        ? <img src={logo} alt={`${project.data.acronym} logo`} loading="lazy" />
        : <span class="project-logo-fallback" aria-hidden="true">{project.data.acronym}</span>}
    </div>
    <span class="status" data-status={project.data.status}>{project.data.status}</span>
  </div>
  <h3 class:list={[logo && 'sr-only']}>{project.data.acronym}</h3>
  <p class="project-title">{project.data.title}</p>
  {(startYear || endYear) && (
    <p class="project-meta">{startYear ?? 'Start not recorded'}–{endYear ?? 'ongoing'}</p>
  )}
  <div class="project-footer">
    {project.data.project_url && <a class="text-link" href={project.data.project_url}>Project website <span aria-hidden="true">↗</span></a>}
    {funders.length > 0 && (
      <ul class="project-funders">
        {funders.map((funder) => (
          <li>
            <a href={funder.url ?? undefined} class="project-funder-link">
              {funder.logo
                ? <img src={funder.logo} alt={funder.logo_alt ?? funder.name} loading="lazy" class="project-funder-logo" />
                : <span>{funder.name}</span>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
