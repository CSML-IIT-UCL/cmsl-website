---
interface Props { platform: 'github' | 'linkedin' | 'scholar' | 'x' | 'bluesky' | 'orcid'; href: string; label?: string }
const { platform, href, label } = Astro.props;
const names: Record<Props['platform'], string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  scholar: 'Google Scholar',
  x: 'X',
  bluesky: 'Bluesky',
  orcid: 'ORCID',
};
const name = label ?? names[platform];
---

